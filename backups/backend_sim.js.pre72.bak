  ok('API-B. add 200 today: legacy spent_today 200, remaining_spendable = remaining_flexible 5800, remaining_pace = tomorrow 580, anchor-day pace follows post-anchor spending (580)', addE.ok && addE.data.state.spent_today === 200 && addE.data.state.remaining_spendable === 5800 && addE.data.state.remaining_pace === 580 && addE.data.state.today_pace === 580);
