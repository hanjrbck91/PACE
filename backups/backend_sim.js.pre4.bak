  ok('API-A. saved plan + position -> state.v2 engine result on the API (flexible 6000, pace 545.45)', E0.ok && E0.data.state.pace_engine === 'v2' && E0.data.state.position_ready === true && E0.data.state.v2.remaining_flexible === 6000 && near(E0.data.state.today_pace, 545.4545) && E0.data.state.pace_status === 'on_pace', E0.data && E0.data.state);
  ok('API-M. fixed_monthly_expenses (10000, legacy) + income (999999) + starting_balance (999999) are NOT used: protected = 4000 + 10000 only', E0.data.settings.fixed_monthly_expenses === 10000 && E0.data.state.v2.protected_money === 14000 && E0.data.state.v2.effective_balance === 20000);
