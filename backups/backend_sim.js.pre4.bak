  const snapIn = deepSnap(inp); const outA = env.calculatePaceV2_(inp), outB = env.calculatePaceV2_(inp);
  ok('INV9-12. calculation never mutates balance / transactions / commitments / plan inputs; same inputs -> same output', deepSnap(inp) === snapIn && deepSnap(outA) === deepSnap(outB) && inp.position.balance === 20000 && inp.transactions.length === 2 && inp.commitments[1].status === 'paid');
  ok('INV8. minimum_daily_spend never changes the mathematical pace (any value)', [0, 1, 250, 5000].every(m => eng({ minimumDailySpend: m }).today_pace === A.today_pace && eng({ minimumDailySpend: m }).tomorrow_pace === A.tomorrow_pace));
