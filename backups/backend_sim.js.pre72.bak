  ok('G-3. Guest reset restores the same demo Pace every time', (() => { const a = call(env, { action: 'resetGuest', token: TG, today: TODAY }).data.state.v2, b = call(env, { action: 'resetGuest', token: TG, today: TODAY }).data.state.v2; return a.today_pace === b.today_pace && a.ready; })());
