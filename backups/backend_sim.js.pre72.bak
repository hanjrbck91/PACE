  const snapIn = deepSnap(inp); const outA = env.calculatePaceV2_(inp), outB = env.calculatePaceV2_(inp);
  ok('INV9-12. calculation never mutates balance / transactions / commitments / plan inputs; same inputs -> same output', deepSnap(inp) === snapIn && deepSnap(outA) === deepSnap(outB) && inp.position.balance === 20000 && inp.transactions.length === 2 && inp.commitments[1].status === 'paid');
  ok('INV8. minimum_daily_spend never changes the mathematical pace (any value)', [0, 1, 250, 5000].every(m => eng({ minimumDailySpend: m }).today_pace === A.today_pace && eng({ minimumDailySpend: m }).tomorrow_pace === A.tomorrow_pace));
  ok('INV2/3. spending below pace raises tomorrow, above pace lowers it (relative to exactly-on-pace)', (() => { const on = eng({ transactions: [ex('2026-09-20', A.today_pace)] }).tomorrow_pace; return eng({ transactions: [ex('2026-09-20', 100)] }).tomorrow_pace > on && eng({ transactions: [ex('2026-09-20', 900)] }).tomorrow_pace < on; })());
  ok('INV1. staying exactly on pace every day (Sep 20-30) preserves the savings target (flexible ~ 0, balance = savings + unpaid commitments)', (() => { const tx = []; let last; for (let d = 20; d <= 30; d++) { const day = '2026-09-' + d; const r = eng({ today: day, transactions: tx.slice() }); tx.push(ex(day, r.today_pace)); last = eng({ today: day, transactions: tx.slice() }); } return Math.abs(last.remaining_flexible) < 0.2 && last.effective_balance >= 14000 - 0.2; })());
  ok('INV4-7. history has no effect; paid unprotected; unpaid protected; savings once', eng({ transactions: [ex('2026-09-10', 5000)] }).remaining_flexible === A.remaining_flexible && Dd.protected_money < A.protected_money && eng({ commitments: [{ amount: 10000, status: 'unpaid' }, { amount: 500, status: 'unpaid' }] }).protected_money === 14500 && eng({ savingsTarget: 0 }).protected_money === 10000);

  // ---- through the API (calculateState -> state) ----
