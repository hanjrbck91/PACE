  const paidE = plan(TE, { income: 999999, savings: 4000, commitments: [{ id: E0.data.plan.commitments[0].id, name: 'Rent', amount: 10000, status: 'paid' }, { name: 'Phone', amount: 500 }] }, '2026-09-20');
