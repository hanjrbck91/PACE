  const delE = call(env, { action: 'deleteTransaction', token: TE, today: '2026-09-20', transaction: { transaction_id: addE.data.transaction.transaction_id } });
  ok('API-3b. deleting it restores effective_balance; anchor still untouched', delE.ok && delE.data.state.v2.effective_balance === 20000 && allOf(TE).data.plan.current_balance === 20000);
  ok('API-tx. calculation never mutates transaction rows (pre-anchor rows byte-identical)', J2(ss.getSheetByName('TX_NEWE').rows.slice(0, 3)) === J2(JSON.parse(txRowsE).slice(0, 3)));
  const paidE = plan(TE, { income: 999999, savings: 4000, commitments: [{ id: E0.data.plan.commitments[0].id, name: 'Rent', amount: 10000, status: 'paid' }, { name: 'Phone', amount: 500 }] }, '2026-09-20');
