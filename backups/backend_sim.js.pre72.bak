  ok('N/M. savings protected exactly once; fixed_monthly_expenses is not an engine input (no double count)', A.protected_money === 4000 + 10000 && !/fixed_monthly_expenses|starting_balance|monthly_income|metro|auto/i.test(JSON.stringify(A)) && /calculatePaceV2_\(input\)/.test(CODE) && !/fixed_monthly_expenses|starting_balance|monthly_income|minimum_daily_spend\s*[-+]/.test(CODE.slice(CODE.indexOf('function calculatePaceV2_'), CODE.indexOf('function applyPaceV2_'))));
  ok('purity: engine has no Sheets/Cache/Lock/Properties/Utilities/fetch calls', !/SpreadsheetApp|CacheService|LockService|PropertiesService|Utilities\.|UrlFetch|setValue|appendRow/.test(CODE.slice(CODE.indexOf('function calculatePaceV2_'), CODE.indexOf('function applyPaceV2_'))));

  // ---- invariants ----
  const deepSnap = o => JSON.stringify(o);
