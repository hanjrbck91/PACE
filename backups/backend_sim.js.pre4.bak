  // stored currency / name never overwritten by the position path
  const TK3 = mkUser(16, 'NEWK', [['key', 'value'], ['monthly_income', 40000], ['monthly_savings_target', 5000], ['fixed_monthly_expenses', 0], ['currency', 'RUB'], ['display_name', 'Kira']]);
  const PK1 = pos(TK3, { current_balance: 800, currency: 'INR', display_name: 'OVERWRITE' }, '2026-03-04');
  ok('E42. an existing backend currency/name is NOT silently overwritten by a different local value', PK1.ok && PK1.data.plan.currency === 'RUB' && PK1.data.plan.display_name === 'Kira' && PK1.data.plan.current_balance_date === '2026-03-04');
  ok('E26b. balance date is the CLIENT local day (2026-03-04), never server time', PK1.data.plan.current_balance_date === '2026-03-04');
  const badPos = (n, tok, extra) => ok(n, (() => { const b = rowsOf('SET_NEWH'); const r = pos(tok, extra); return !r.ok && rowsOf('SET_NEWH') === b; })());
  badPos('E-bad1. position_only without a balance rejected', TH3, {});
  badPos('E-bad2. negative balance rejected', TH3, { current_balance: -3 });
  badPos('E-bad3. future balance date rejected', TH3, { current_balance: 1, current_balance_date: '2999-01-01' });
  badPos('E45. invalid currency rejected', TH3, { current_balance: 1, currency: 'USD' });
  ok('E-dry. position_only dry_run previews and writes nothing', (() => { const t = mkUser(17, 'NEWL', [['key', 'value'], ['monthly_income', 30000], ['monthly_savings_target', 3000], ['fixed_monthly_expenses', 0]]); const b = rowsOf('SET_NEWL'); const d = pos(t, { current_balance: 9000, dry_run: true }); return d.ok && d.data.plan.current_balance === 9000 && d.data.state.position_ready === true && rowsOf('SET_NEWL') === b && st3(t).plan.setup_state === 'needs_position'; })());
  ok('E-second. re-running position setup with a NEW balance replaces the anchor only on explicit request', pos(TH3, { current_balance: 25000 }, '2026-09-22').data.plan.current_balance === 25000);

  // ---------- SAFETY ----------
  const otherBefore = rowsOf('SET_NEWK'), mSet3 = J2(ss.getSheetByName('SET_MUH').rows);
  const spoofP = call(env, { action: 'saveMoneyPlan', token: TH3, today: '2026-09-20', user_key: 'NEWK', settings_sheet: 'SET_NEWK', plan: { position_only: true, current_balance: 1, settings_sheet: 'SET_NEWK', user_key: 'NEWK' } });
  ok('S34. cross-user: spoofed identifiers only ever write the caller\'s own tab', spoofP.ok && rowsOf('SET_NEWK') === otherBefore && J2(ss.getSheetByName('SET_MUH').rows) === mSet3);
  ok('S35/36. Guest stays complete, is never forced into setup, cannot use either onboarding path', st3(TG).plan.setup_state === 'complete' && !ob(TG, {}).ok && !pos(TG, { current_balance: 1 }).ok && st3(TG).state.position_ready === true);
  ok('S37. a failed save never marks a profile complete (checked for onboarding + position)', st3(TG3).plan.setup_state === 'complete' && (() => { const t = mkUser(26, 'FAIL1'); ob(t, { currency: 'ZZZ' }); return st3(t).plan.setup_state === 'needs_plan'; })());
  ok('S38/39. no access code / hash / secret in any onboarding response', !J2([OG1, OG2, BJ3, PE1, PK1]).match(/access_credential|SESSION_SECRET|[0-9a-f]{64}/) && !J2([OG1, PE1]).includes(NEWCODE));
  ok('S40. no GET can start, read or mutate onboarding', ['saveMoneyPlan', 'all', 'position_only'].every(a => JSON.parse(env.doGet({ parameter: { action: a, token: TH3, current_balance: 1 } }).getContent()).error === 'unauthorized'));
  ok('S-auth. unauthenticated / bad-token onboarding rejected', ob(undefined, {}).error === 'unauthorized' && pos('a.b', { current_balance: 1 }).error === 'unauthorized');
  ok('S41. Pace still driven by the client local day only (same anchor, different day -> different days remaining)', st3(TH3, '2026-09-25').state.v2.days_remaining_incl_today === 6 && st3(TH3, '2026-09-20').state.v2.days_remaining_incl_today === 11);
  ok('S-real. Muhammed + Friend (real profiles) untouched by all Step 3 work: still needs_position, settings byte-identical', st3(TM).plan.setup_state === 'needs_position' && st3(TF).plan.setup_state === 'needs_position' && J2(ss.getSheetByName('SET_MUH').rows) === mSet3);

  console.log('\n== Legacy tabs untouched at the end ==');
  ok('legacy Transactions/Settings byte-identical to start', legacyBefore === JSON.stringify(ss.getSheetByName('Transactions').rows) + JSON.stringify(ss.getSheetByName('Settings').rows));

  console.log('\n' + pass + ' passed, ' + fail + ' failed');
  process.exit(fail ? 1 : 0);
}
main();
