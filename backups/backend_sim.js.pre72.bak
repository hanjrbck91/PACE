  ok('API-min. minimum_daily_spend saved: gap exposed, today_pace unchanged', (() => { const r = plan(TE, { income: 999999, savings: 4000, commitments: [{ id: E0.data.plan.commitments[0].id, name: 'Rent', amount: 10000, status: 'paid' }, { name: 'Phone', amount: 500 }], minimum_daily_spend: 2000 }, '2026-09-20'); return r.ok && r.data.state.v2.minimum_spend_gap > 0 && r.data.state.pace_status === 'below_minimum' && near(r.data.state.today_pace, 15500 / 10); })());

