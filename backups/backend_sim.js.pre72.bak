  ok('S2-final. legacy state fields keep their shape (frontend compatible): every prior key still present', ['as_of', 'inputs', 'month', 'discretionary_monthly', 'total_spendable', 'initial_daily_pace', 'daily_allowance', 'today_pace', 'spent_today', 'expected_today', 'today_variance', 'remaining_spendable', 'remaining_pace', 'remaining_discretionary', 'safe_daily_for_rest_of_month', 'expected_spend_to_date', 'actual_spend_to_date', 'income_this_month', 'pace', 'status', 'current_balance', 'transaction_count'].every(k => k in allOf(TM).data.state) && allOf(TM).data.state.month.days_remaining_incl_today >= 1);

